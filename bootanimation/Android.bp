prebuilt_media {
    name: "bootanimation.zip",
    src: select(soong_config_variable("lineage_bootanimation", "resolution"), {
        "720": "bootanimation_720.zip",
        "1080": "bootanimation_1080.zip",
        "1440": "bootanimation_1440.zip",
        default: "bootanimation_1080.zip",
    }),
    product_specific: true,
}

install_symlink {
    name: "bootanimation-dark.zip",
    product_specific: true,
    installed_location: "media/bootanimation-dark.zip",
    symlink_target: "bootanimation.zip",
}
